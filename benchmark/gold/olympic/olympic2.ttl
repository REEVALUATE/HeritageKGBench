    crm:P2_has_type  ex:type_handwritten_letter ;
    crm:P128_carries ex:letter_text , ex:typed_caption , ex:letterhead_inscription ;
    crm:P3_has_note  "Handwritten letter from Baron Pierre de Coubertin dated 14 June 1894. Typed caption available in Greek, English, and French below the letter."@en ;
