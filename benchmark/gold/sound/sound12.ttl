# INSTRUMENTS
ex:jatun_ayarichi a cacao:CACAO_0000023 ;
    rdfs:label "Jatun ayarichi (large double-rowed panpipe, 7 pipes)"@en ;
    crm:P2_has_type aat:300042548 ;
    owl:sameAs wd:Q218802 ;
    crm:P43_has_dimension [
        a crm:E54_Dimension ;
        rdfs:label "7 pipes"@en ;
        crm:P90_has_value "7"^^xsd:integer ;
        crm:P91_has_unit ex:unit_pipe ;
        crm:P2_has_type ex:type_count
    ] ;
    crm:P43_has_dimension [
        a crm:E54_Dimension ;
        rdfs:label "2 rows"@en ;
        crm:P90_has_value "2"^^xsd:integer ;
        crm:P91_has_unit ex:unit_row ;
        crm:P2_has_type ex:type_count
    ] ;
    crm:P3_has_note "Played by guías; largest pipes overblown (to third partial) to reach range of small panpipes."@en .

ex:una_ayarichi a cacao:CACAO_0000023 ;
    rdfs:label "Uña ayarichi (small single-row panpipe, 7 pipes)"@en ;
    crm:P2_has_type aat:300042548 ;
    owl:sameAs wd:Q218802 ;
    crm:P43_has_dimension [
        a crm:E54_Dimension ;
        rdfs:label "7 pipes"@en ;
        crm:P90_has_value "7"^^xsd:integer ;
        crm:P91_has_unit ex:unit_pipe ;
        crm:P2_has_type ex:type_count
    ] ;
    crm:P43_has_dimension [
        a crm:E54_Dimension ;
        rdfs:label "1 row"@en ;
        crm:P90_has_value "1"^^xsd:integer ;
        crm:P91_has_unit ex:unit_row ;
        crm:P2_has_type ex:type_count
    ] ;
    crm:P3_has_note "Follows main melody in parallel seconds."@en .

ex:caja_drum a cacao:CACAO_0000023 ;
    rdfs:label "Caja drum (large drum with snare)"@en ;
    crm:P2_has_type aat:300041755 ;
    crm:P3_has_note "Beaten with mallet in right hand mostly in unison; occasionally staggered rhythmically."@en .

# DANCE TYPE & CULTURAL MEANING
ex:ayarichi_dance a crm:E55_Type ;
    rdfs:label "Ayarichi dance (religious; remembrance of the dead; danza de los muertos)"@en ;
    owl:sameAs wd:Q109424143 ;
    crm:P3_has_note "Religious expression connected to Andean worldview; attachment to the earth. Music is simple, festive huayño style. Etymology: Quechua 'aya' = corpse."@en .

ex:star_formation a crm:E55_Type ;
    rdfs:label "Star formation of ayarichi dancers (Fortún 1978)"@en .

# HISTORICAL DOCUMENTS MENTIONING AYARICHI
ex:vocabulary_aymara_1612 a crm:E31_Document ;
    rdfs:label "Vocabulario de la Lengua Aymará (Bertonio, 1612)"@en ;
    crm:P14_carried_out_by ex:bertonio ;
    crm:P4_has_time-span [ a crm:E52_Time-Span ; crm:P81_ongoing_throughout "1612-01-01/1612-12-31" ; crm:P82_at_some_time_within "1612-01-01/1612-12-31" ] ;
    crm:P3_has_note "First known mention of 'ayarichi': instrument producing harmonies like organ pipes ('instrumento como organillos, que hazen armonia')."@en .

ex:historia_nuevo_mundo a crm:E31_Document ;
    rdfs:label "Historia del Nuevo Mundo (Cobo, 1613–1653)"@en ;
    crm:P14_carried_out_by ex:cobo ;
    crm:P4_has_time-span [ a crm:E52_Time-Span ; crm:P81_ongoing_throughout "1613-01-01/1653-12-31" ; crm:P82_at_some_time_within "1613-01-01/1653-12-31" ] ;
    crm:P3_has_note "Seven-pipe panpipes aligned like organ pipes, used in dances ('instrumento compuesto de siete flautillas…')."@en .

