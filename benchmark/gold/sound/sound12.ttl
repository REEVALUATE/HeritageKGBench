    crm:P4_has_time-span [ a crm:E52_Time-Span ; crm:P81_ongoing_throughout "1816-01-01/1816-12-31" ; crm:P82_at_some_time_within "1816-01-01/1816-12-31" ] ;
    crm:P3_has_note "Commemorated March 12 in Yamparaéz by ayarichi performance."@en .

