# Gold standard: sound15 – Bedouin boy recording (Hans Helfritz, Yemen 1930) & acoustic art (2011)
# Source text : txt/sound/sound15.txt
# Students    : annotator6, annotator2, annotator9
# Primary     : annotator6 (wax cylinder as E84, Prix Marulic, CD 2013) + annotator2/annotator9 (Wikidata)

@prefix crm:   <http://www.cidoc-crm.org/cidoc-crm/> .
@prefix cacao: <http://w3id.org/cacao/> .
@prefix ex:    <https://example.org/> .
@prefix wd:    <http://www.wikidata.org/entity/> .
@prefix aat:   <http://vocab.getty.edu/aat/> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix owl:   <http://www.w3.org/2002/07/owl#> .

# PEOPLE
ex:helfritz a crm:E21_Person ;
    rdfs:label "Hans Helfritz (composer, explorer, filmmaker, ethnomusicologist)"@en ;
    owl:sameAs wd:Q1583549 ;
    crm:P3_has_note "Studied composition with Hindemith and comparative musicology under Hornbostel. First white man in Shabwa; worldwide fame from desert journey. Travel book author."@en .

ex:eva_poepplein a crm:E21_Person ;
    rdfs:label "Eva Pöpplein (sound artist, duo partner)"@en .

ex:bedouin_boy a crm:E21_Person ;
    rdfs:label "Anonymous Bedouin boy (recorded in Yemen, 1930)"@en ;
    crm:P3_has_note "Name unknown. Treble voice clear as a bell. Part of the Helfritz Hadramaut collection."@en .

# INSTITUTIONS
ex:berlin_phonogramm_archiv a crm:E74_Group ;
    rdfs:label "Berlin Phonogramm-Archiv"@en ;
    owl:sameAs wd:Q700547 ;
    crm:P3_has_note "One of the most significant ethnomusicological collections in the world; conserves the largest acoustic archive documenting the noise of time."@en .

ex:oper_dynamo_west a crm:E74_Group ;
    rdfs:label "Oper Dynamo West (invited Pöpplein and duo for archive research)"@en .

# PLACES
ex:yemen a crm:E53_Place ;
    rdfs:label "Yemen"@en ;
    owl:sameAs wd:Q805 .

ex:hadramaut a crm:E53_Place ;
    rdfs:label "Hadramaut (Yemen desert)"@en ;
    owl:sameAs wd:Q319082 ;
    crm:P89_falls_within ex:yemen .

ex:shabwa a crm:E53_Place ;
    rdfs:label "Shabwa (legendary desert city, Yemen)"@en ;
    owl:sameAs wd:Q2005211 ;
    crm:P89_falls_within ex:hadramaut .

ex:hau3 a crm:E53_Place ;
    rdfs:label "HAU 3 (Hebbel am Ufer), Berlin"@en ;
    owl:sameAs wd:Q1618393 .

# DEVICE
ex:edison_phonograph a cacao:CACAO_0000023 ;
    rdfs:label "Edison phonograph (used by Helfritz in desert)"@en ;
    crm:P2_has_type aat:300265798 ;
    owl:sameAs wd:Q132173 .

# DESERT EXPEDITION (1930)
ex:expedition_1930 a crm:E7_Activity ;
    rdfs:label "Hans Helfritz desert expedition to Yemen/Hadramaut (1930)"@en ;
    crm:P14_carried_out_by ex:helfritz ;
    crm:P7_took_place_at ex:shabwa ;
    crm:P4_has_time-span [ a crm:E52_Time-Span ; crm:P81_ongoing_throughout "1930-01-01/1930-12-31" ; crm:P82_at_some_time_within "1930-01-01/1930-12-31" ] ;
    crm:P3_has_note "First white man to appear and enter Shabwa. Sensation and worldwide fame."@en .

# WAX CYLINDER RECORDING (1930)
ex:prod_bedouin_cylinder a crm:E12_Production ;
    rdfs:label "Production of wax cylinder recording of Bedouin boy (Yemen, 1930)"@en ;
    crm:P14_carried_out_by ex:helfritz ;
    crm:P7_took_place_at ex:hadramaut ;
    crm:P16_used_specific_object ex:edison_phonograph ;
    crm:P4_has_time-span [ a crm:E52_Time-Span ; crm:P81_ongoing_throughout "1930-01-01/1930-12-31" ; crm:P82_at_some_time_within "1930-01-01/1930-12-31" ] ;
    crm:P108_has_produced ex:bedouin_cylinder .

ex:bedouin_cylinder a crm:E84_Information_Carrier, cacao:CACAO_0000023 ;
    rdfs:label "Wax cylinder recording: Bedouin boy singing (Yemen, 1930)"@en ;
    crm:P2_has_type aat:300028640 ;
    owl:sameAs wd:Q691783 ;
    crm:P50_has_current_keeper ex:berlin_phonogramm_archiv ;
    crm:P128_carries ex:bedouin_song, ex:wax_cylinder_noise .

ex:bedouin_song a crm:E73_Information_Object ;
    rdfs:label "Melody of Bedouin boy (treble voice, Yemen 1930)"@en ;
    crm:P3_has_note "Treble voice clear as a bell; melody shimmers through granular noise and acoustic patina; terminates abruptly mid-phrase at physical end of cylinder."@en ;
    crm:P129_is_about ex:bedouin_boy .

ex:wax_cylinder_noise a crm:E73_Information_Object ;
    rdfs:label "Historical wax cylinder noise (acoustic patina; 'noise of time')"@en ;
    crm:P3_has_note "Granular noise, delicately melting rusting, crackle, density waves. Layered; contour-rich surface with depth field."@en .

# ARCHIVE RESEARCH JOURNEY (2011)
ex:archive_research_2011 a crm:E7_Activity ;
    rdfs:label "Research journey through Berlin Phonogramm-Archiv (invited by Oper Dynamo West, 2011)"@en ;
    crm:P14_carried_out_by ex:eva_poepplein ;
    crm:P7_took_place_at ex:berlin_phonogramm_archiv ;
    crm:P4_has_time-span [ a crm:E52_Time-Span ; crm:P81_ongoing_throughout "2011-01-01/2011-12-31" ; crm:P82_at_some_time_within "2011-01-01/2011-12-31" ] ;
    crm:P3_has_note "Over 600 wax cylinders listened to from all corners of the earth; melody and noise both treated as aesthetic material."@en .

