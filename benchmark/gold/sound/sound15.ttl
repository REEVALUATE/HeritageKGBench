    crm:P94_has_created ex:radio_feature_2011 ;
    crm:P4_has_time-span [ a crm:E52_Time-Span ; crm:P81_ongoing_throughout "2011-01-01/2011-12-31" ; crm:P82_at_some_time_within "2011-01-01/2011-12-31" ] .

ex:radio_feature_2011 a crm:E73_Information_Object ;
    rdfs:label "50-minute radio feature (German radio, 2011) – Prix Marulić"@en ;
    crm:P2_has_type aat:300387763 ;
    crm:P3_has_note "Interwoven rolling sounds and wax-cylinder melodies; broadcast on German radio; awarded Prix Marulić 2011."@en .

